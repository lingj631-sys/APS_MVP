        const onStartDateChange = async () => {
          try {
            const dt = new Date(startDate.value);
            if (!isNaN(dt.getTime())) {
              dt.setDate(dt.getDate() - 1);
              const yyyy = dt.getFullYear();
              const mm = String(dt.getMonth() + 1).padStart(2, '0');
              const dd = String(dt.getDate()).padStart(2, '0');
              baselineDate.value = `${yyyy}-${mm}-${dd}`;
            }
            await saveCalendarConfig(false);
          } catch (e) {
            console.error("onStartDateChange error: ", e);
          }
        };

        const onBaselineDateChange = async () => {
          await saveCalendarConfig(false);
        };

        const selectHorizon = async (days) => {
          horizonDays.value = Number(days);
          await saveCalendarConfig(false);
          showToast(`已切换排产计划期为 ${days} 天。请确认参数后点击右上角【执行智能排产】。`);
        };

        const toggleDayWork = async (day) => {
          const nextWork = !day.is_work;
          day.is_work = nextWork;
          day.shifts = {
            '早班': nextWork,
            '中班': nextWork,
            '晚班': nextWork,
          };
          day.open_shifts_count = nextWork ? 3 : 0;
          day.capacity_hours = nextWork ? 24.0 : 0.0;
          day.tag = nextWork ? (day.is_weekend ? '周末连产' : '正常工日') : (day.is_weekend ? '周末休假' : '停产检修');

          dayShiftOverrides.value[day.date_str] = {
            is_work: nextWork,
            shifts: day.shifts,
          };
          updateCalendarStats();
          await saveCalendarConfig(false);
        };

        const toggleShiftWork = async (day, shiftName) => {
          day.shifts[shiftName] = !day.shifts[shiftName];
          const openCount = Object.values(day.shifts).filter(Boolean).length;
          day.open_shifts_count = openCount;
          day.is_work = openCount > 0;
          day.capacity_hours = openCount * 8.0;
          if (openCount === 3) day.tag = day.is_weekend ? '周末连产' : '正常工日';
          else if (openCount === 0) day.tag = day.is_weekend ? '周末休假' : '停产检修';
          else day.tag = `部分开班 (${openCount}/3班)`;

          dayShiftOverrides.value[day.date_str] = {
            is_work: day.is_work,
            shifts: day.shifts,
          };
          updateCalendarStats();
          await saveCalendarConfig(false);
        };

        const updateCalendarStats = () => {
          const days = calendarConfig.value.days || [];
          let workDays = 0;
          let restDays = 0;
          let totalHours = 0;
          days.forEach(d => {
            if (d.is_work) workDays++;
            else restDays++;
            totalHours += (d.capacity_hours || 0);
          });
          calendarConfig.value.working_days = workDays;
          calendarConfig.value.rest_days = restDays;
          calendarConfig.value.total_capacity_hours = totalHours;
        };

        const applyCalendarTemplate = async (mode) => {
          calendarMode.value = mode;
          dayShiftOverrides.value = {};
          await saveCalendarConfig(false);
          const modeName = mode === 'SEVEN_ZERO' ? '7×3 连续生产' : (mode === 'FIVE_TWO' ? '5×3 做五休二' : '4×3 做四休三');
          showToast(`已切换为【${modeName}】工作制。请调整参数后点击右上角【执行智能排产】进行计算。`);
        };

        const saveCalendarConfig = async (notify = true) => {
          try {
            const res = await fetch('/api/calendar/update', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                start_date: startDate.value,
                baseline_date: baselineDate.value,
                horizon_days: horizonDays.value,
                calendar_mode: calendarMode.value,
                day_shift_overrides: dayShiftOverrides.value,
              })
            });
            const data = await res.json();
            if (data.calendar) {
              calendarConfig.value = data.calendar;
              dayShiftOverrides.value = data.calendar.day_shift_overrides || {};
            }
            if (notify) showToast("工厂日历配置已保存");
          } catch (e) {
            console.error("保存日历配置出错: ", e);
          }
        };

        const saveAndSolve = async () => {
          await saveCalendarConfig(false);
          await runSolve();
        };

        const resolveOverloadWith7x3 = async () => {
          showOverloadModal.value = false;
          calendarMode.value = 'SEVEN_ZERO';
          dayShiftOverrides.value = {};
          await saveCalendarConfig(false);
          await runSolve();
        };

        const resolveOverloadWith15Days = async () => {
          showOverloadModal.value = false;
          horizonDays.value = 15;
          await saveCalendarConfig(false);
          await runSolve();
        };

        const adoptAiRecommendation = async (andSolve = false) => {
          if (!calendarConfig.value || !calendarConfig.value.ai_recommendation) return;
          const recMode = calendarConfig.value.ai_recommendation.recommended_mode;
          calendarMode.value = recMode;
          dayShiftOverrides.value = {};
          await saveCalendarConfig(false);
          showAiRecModal.value = false;
          const modeName = calendarConfig.value.ai_recommendation.recommended_name;
          showToast(`已成功采纳 AI 智能推荐：切换为【${modeName}】工作制！`);
          if (andSolve) {
            await runSolve();
          }
        };

        const runSolve = async () => {
          solving.value = true;
          timerSeconds.value = 0;
          timerInterval = setInterval(() => { timerSeconds.value += 1; }, 1000);

          try {
            const enabled_rule_ids = rules.value.filter(r => r.checked).map(r => r.rule_id);
            const r_sf_01 = rules.value.find(r => r.rule_id === 'R-SF-01');
            const r_fg_03 = rules.value.find(r => r.rule_id === 'R-FG-03');
            const r_wl_26 = rules.value.find(r => r.rule_id === 'R-WL-26');
            const r_sy_08 = rules.value.find(r => r.rule_id === 'R-SY-08');
            const allow_105_sf = (r_wl_26 && r_wl_26.load_limit_mode === '105') || (r_sy_08 && r_sy_08.load_limit_mode === '105') || (r_sf_01 ? (r_sf_01.load_limit_mode === '105') : false);
            const allow_105_fg = (r_wl_26 && r_wl_26.load_limit_mode === '105') || (r_sy_08 && r_sy_08.load_limit_mode === '105') || (r_fg_03 ? (r_fg_03.load_limit_mode === '105') : false);

            const res = await fetch('/api/solve', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                site: selectedSite.value,
                calendar_mode: calendarMode.value,
                enabled_rules: enabled_rule_ids,
                time_limit_seconds: 35.0,
                horizon_days: horizonDays.value,
                start_date: startDate.value,
                baseline_date: baselineDate.value,
                day_shift_overrides: dayShiftOverrides.value,
                allow_105_utilization_fg: allow_105_fg,
                allow_105_utilization_sf: allow_105_sf,
                lookahead_enabled: siteSettings.value.lookahead_enabled,
                lookahead_days: siteSettings.value.lookahead_days,
                max_pull_forward_days: siteSettings.value.max_pull_forward_days,
                rule_options: {
                  'R-SF-01': { load_limit_mode: r_sf_01 ? r_sf_01.load_limit_mode : '100' },
                  'R-FG-03': { load_limit_mode: r_fg_03 ? r_fg_03.load_limit_mode : '100' },
                  'R-WL-26': { load_limit_mode: r_wl_26 ? r_wl_26.load_limit_mode : '100' },
                  'R-SY-08': { load_limit_mode: r_sy_08 ? r_sy_08.load_limit_mode : '100' }
                }
              })
            });

            if (!res.ok) {
              let errorData = null;
              try {
                errorData = await res.json();
              } catch (_) {}

              if (errorData && errorData.detail) {
                if (typeof errorData.detail === 'object') {
                  overloadInfo.value = errorData.detail;
                  showOverloadModal.value = true;
                  return;
                } else {
                  alert("排产计算提醒:\n" + errorData.detail);
                  return;
                }
              }
              alert(`排产计算提示: 计划生成未完成 (HTTP ${res.status})`);
              return;
            }

            const data = await res.json();
            kpi.value = data.kpi;
            shiftColumns.value = data.shift_columns;
            lineLoads.value = data.line_loads;
            fgBalance.value = data.fg_balance;
            sfBalance.value = data.sf_balance;
            tasks.value = data.tasks;
            checks.value = data.checks;
            complianceMatrix.value = data.compliance_matrix;
            ganttHorizon.value = data.gantt_horizon;
            shiftsInfo.value = data.shifts_info || [];
            lookaheadSummary.value = data.lookahead_summary || null;
            emptyShiftReasons.value = data.empty_shift_reasons || {};
            isManualAudited.value = false;
            manualFilename.value = '';
            if (!hasSolved.value) currentTab.value = 'balance';
            hasSolved.value = true;
            await loadCalendar();
            if (data.lookahead_summary && data.lookahead_summary.is_enabled && data.lookahead_summary.pulled_orders_count > 0) {
              showToast(`排产成功！30天前瞻已顺位合批拉动 ${data.lookahead_summary.pulled_orders_count} 个远期订单（${data.lookahead_summary.pulled_quantity_total}件），有效减少产线换型！`);
            } else {
              showToast("排产运算成功！已更新物料平衡与工单排程");
            }
          } catch (e) {
            alert("排产计算出错: " + e.message);
          } finally {
            clearInterval(timerInterval);
            solving.value = false;
          }
        };

        const saveInputEdits = async () => {
