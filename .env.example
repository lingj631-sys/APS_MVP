# ==============================================================================
# APS MVP Environment Configuration Template (.env.example)
# ==============================================================================

# Network & Server Binding
# One factory = one instance: use PORT 8000 for WL, 8001 for SY38.
HOST=0.0.0.0
PORT=8000
RELOAD=false
APP_ENV=production

# Application Defaults
# FACTORY_SITE pins this instance to one factory and rejects site switches.
# Leave empty for a shared development instance.
FACTORY_SITE=WL
DEFAULT_SITE=WL
DEFAULT_USER=guest.user

# Target Production Domain
APS_DOMAIN=


