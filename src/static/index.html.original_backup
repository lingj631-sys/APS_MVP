        </div>

        <!-- Modal Footer Actions -->
        <div class="bg-slate-50 px-6 py-3.5 border-t border-slate-200 flex flex-wrap items-center justify-between gap-3 text-xs">
          <div class="flex items-center space-x-2">
            <button @click="adoptAiRecommendation(false)"
                    class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg shadow transition cursor-pointer flex items-center space-x-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
              <span>一键采纳推荐制式 ({{ calendarConfig.ai_recommendation.recommended_short_name }})</span>
            </button>
            <button @click="adoptAiRecommendation(true)"
                    class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-lg shadow transition cursor-pointer flex items-center space-x-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <span>一键采纳并立即排产</span>
            </button>
          </div>
          <button @click="showAiRecModal = false" class="px-3.5 py-2 bg-white border border-slate-300 text-slate-700 hover:bg-slate-100 font-medium rounded-lg transition cursor-pointer">
            关闭
          </button>
        </div>
      </div>
    </div>

    <!-- Notification Toast -->
    <div v-if="toastMessage" class="fixed bottom-5 right-5 z-50 bg-slate-900 text-white text-xs px-4 py-2.5 rounded-lg shadow-xl flex items-center space-x-2 border border-slate-700">
      <span>{{ toastMessage }}</span>
    </div>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-3 text-center text-xs text-slate-400">
      APS 智能高级生产排程系统 · 制造业物流与生产协同工作台 · 本地运行地址: http://127.0.0.1:8000
    </footer>
  </div>

  <script>
    const { createApp, ref, computed, onMounted } = Vue;

    createApp({
      setup() {
        const selectedSite = ref("WL");
        const calendarMode = ref("SEVEN_ZERO");
        const currentTab = ref("balance");
        const lookaheadSummary = ref(null);
        const siteSettings = ref({
          site: "WL",
          horizon_days: 10,
          start_date: "2026-10-12",
          baseline_date: "2026-10-11",
          calendar_mode: "SEVEN_ZERO",
          lookahead_enabled: true,
          lookahead_days: 30,
          max_pull_forward_days: 10,
          campaign_merge_enabled: true,
          day_shift_overrides: {},
        });

        const calendarModeDisplay = computed(() => {
          const sLabel = (selectedSite.value === 'SY38' ? '2' : '3');
          if (calendarMode.value === 'SEVEN_ZERO') return `连续生产 (7×${sLabel})`;
          if (calendarMode.value === 'FIVE_TWO') return `做五休二 (5×${sLabel})`;
          if (calendarMode.value === 'FOUR_THREE') return `做四休三 (4×${sLabel})`;
          return calendarMode.value;
        });
        const materialView = ref("FG");
        const materialSearch = ref("");
        const selectedRuleCategory = ref("全部");
        const selectedRuleNature = ref("全部");
        const ruleSearchQuery = ref("");
        const expandedRules = ref({});
        const complianceCategoryFilter = ref("全部");
        const complianceStatusFilter = ref("ALL");

        const toggleRuleExpand = (rId) => {
          expandedRules.value[rId] = !expandedRules.value[rId];
        };

        const expandAllAiLogic = (expand) => {
          rules.value.forEach(r => {
            expandedRules.value[r.rule_id] = expand;
          });
        };

        const getCategoryBadgeClass = (category) => {
          switch (category) {
            case '核心排班':
              return 'bg-indigo-50 text-indigo-700 border-indigo-200';
            case '物料与库存':
              return 'bg-emerald-50 text-emerald-700 border-emerald-200';
            case '设备与产能':
              return 'bg-amber-50 text-amber-700 border-amber-200';
            case '工装与人员':
              return 'bg-orange-50 text-orange-700 border-orange-200';
            case '订单与交期':
              return 'bg-blue-50 text-blue-700 border-blue-200';
            case '需求倒排':
              return 'bg-cyan-50 text-cyan-700 border-cyan-200';
            case '异常应对':
              return 'bg-fuchsia-50 text-fuchsia-700 border-fuchsia-200';
            case '系统架构':
              return 'bg-sky-50 text-sky-700 border-sky-200';
            case '测试场景':
              return 'bg-slate-100 text-slate-700 border-slate-200';
            default:
              return 'bg-slate-100 text-slate-700 border-slate-200';
          }
        };

        const showUpperLoadTable = ref(true);

        // Input menu navigation
        const inputMenu = ref("orders");
        const orderSearch = ref("");
        const stockSearch = ref("");
        const toolingSearch = ref("");
        const pmSearch = ref("");
        const materialEtaSearch = ref("");
        const customerSearch = ref("");
        const showAddOrderModal = ref(false);
        const showLineDetailModal = ref(false);
        const newOrder = ref({ part_no: "W000076959VA", due_date: "10/18", demand_quantity: 1200 });

        const solving = ref(false);
        const hasSolved = ref(false);
        const timerSeconds = ref(0);
        let timerInterval = null;

        const toastMessage = ref("");
        const showToast = (msg) => {
          toastMessage.value = msg;
          setTimeout(() => { toastMessage.value = ""; }, 3000);
        };

        // Data holders
        const inputData = ref({
          orders: [],
          initial_stock: [],
          fg_params: [],
          sf_params: [],
          bom: [],
          tooling_molds: [],
          pm_schedules: [],
          material_arrivals: [],
          customer_tiers: []
        });
        const calendarInfo = ref({ shifts: [], modes: [] });
        const rules = ref([]);
        const kpi = ref(null);
        const shiftColumns = ref([]);
        const lineLoads = ref([]);
        const fgBalance = ref([]);
        const sfBalance = ref([]);
        const tasks = ref([]);
        const checks = ref([]);
        const complianceMatrix = ref([]);

        // Factory Calendar & Horizon Workstation state
        const horizonDays = ref(10);
        const startDate = ref("2026-10-12");
        const baselineDate = ref("2026-10-11");
        const calendarConfig = ref({
          baseline_date: "2026-10-11",
          start_date: "2026-10-12",
          horizon_days: 10,
          horizon_options: [5, 10, 15],
          calendar_mode: "SEVEN_ZERO",
          day_shift_overrides: {},
          days: [],
          total_days: 10,
          working_days: 10,
          rest_days: 0,
          total_capacity_hours: 240.0,
          orders_in_scope_count: 7,
          orders_out_of_scope_count: 2,
          total_orders_count: 9,
        });
        const dayShiftOverrides = ref({});

        // Gantt Interactive state
        const ganttViewMode = ref("gantt");
        const ganttLineFilter = ref("ALL");
        const ganttStageFilter = ref("ALL");
        const ganttStatusFilter = ref("ALL");
        const ganttSearch = ref("");
        const enableBomLinkHighlight = ref(true);
        const hoveredTask = ref(null);
        const selectedTask = ref(null);
        const showTaskModal = ref(false);
        const showOverloadModal = ref(false);
        const overloadInfo = ref({});
        const showAiRecModal = ref(false);
        const ganttHorizon = ref(null);
        const shiftsInfo = ref([]);
        const ganttTrackMode = ref("BY_PART");
        const psiProductionFilter = ref("ALL");
        const emptyShiftReasons = ref({});
        const expandedAuditRules = ref(new Set());
        const uploadingManualExcel = ref(false);
        const isManualAudited = ref(false);
        const manualFilename = ref("");
        const backupAutoScheduleData = ref(null);
        const manualExcelInput = ref(null);

        // Computed
        const enabledRulesCount = computed(() => {
          return rules.value.filter(r => r.checked).length;
        });

        const ruleCategories = computed(() => {
          const counts = {};
          rules.value.forEach(r => {
            counts[r.category] = (counts[r.category] || 0) + 1;
          });
          const list = [{ name: "全部", count: rules.value.length }];
          const definedOrder = ["核心排班", "物料与库存", "设备与产能", "需求倒排", "异常应对", "系统架构", "测试场景", "工装与人员", "订单与交期"];
          definedOrder.forEach(cat => {
            if (counts[cat]) {
              list.push({ name: cat, count: counts[cat] });
            }
          });
          Object.keys(counts).forEach(cat => {
            if (!definedOrder.includes(cat) && cat !== "全部") {
              list.push({ name: cat, count: counts[cat] });
            }
          });
          return list;
        });

        const ruleNatures = computed(() => {
          const counts = {};
          rules.value.forEach(r => {
            const nat = r.nature || "硬约束";
            counts[nat] = (counts[nat] || 0) + 1;
          });
          const list = [{ name: "全部", count: rules.value.length }];
          ["硬约束", "软约束", "业务策略", "架构约束", "测试用例"].forEach(nat => {
            if (counts[nat]) {
              list.push({ name: nat, count: counts[nat] });
            }
          });
          return list;
        });

        const filteredRules = computed(() => {
          return rules.value.filter(r => {
            if (selectedRuleCategory.value !== "全部" && r.category !== selectedRuleCategory.value) {
              return false;
            }
            if (selectedRuleNature.value !== "全部" && r.nature !== selectedRuleNature.value) {
              return false;
            }
            if (ruleSearchQuery.value.trim()) {
              const q = ruleSearchQuery.value.trim().toLowerCase();
              const matchId = (r.rule_id || "").toLowerCase().includes(q);
              const matchName = (r.name || "").toLowerCase().includes(q);
              const matchDesc = (r.description || "").toLowerCase().includes(q);
              const matchAi = (r.ai_logic || "").toLowerCase().includes(q);
              const matchCat = (r.category || "").toLowerCase().includes(q);
              if (!matchId && !matchName && !matchDesc && !matchAi && !matchCat) return false;
            }
            return true;
          });
        });

        const filteredComplianceMatrix = computed(() => {
          return complianceMatrix.value.filter(r => {
            if (complianceCategoryFilter.value !== "全部" && r.category !== complianceCategoryFilter.value) {
              return false;
            }
            if (complianceStatusFilter.value === "PASS" && !r.status.includes("PASS")) return false;
            if (complianceStatusFilter.value === "FAIL" && !r.status.includes("FAIL")) return false;
            if (complianceStatusFilter.value === "SKIPPED" && !r.status.includes("SKIPPED")) return false;
            return true;
          });
        });

        const isMaterialScheduled = (m) => {
          if (!m.plan) return false;
          return Object.values(m.plan).some(v => Number(v) > 0);
        };

        const totalMaterialsInStage = computed(() => {
          if (materialView.value === 'FG') return fgBalance.value.length;
          if (materialView.value === 'SF') return sfBalance.value.length;
          return fgBalance.value.length + sfBalance.value.length;
        });

        const scheduledMaterialsCount = computed(() => {
          let list = [];
          if (materialView.value === 'FG') list = fgBalance.value;
          else if (materialView.value === 'SF') list = sfBalance.value;
          else list = [...fgBalance.value, ...sfBalance.value];
          return list.filter(isMaterialScheduled).length;
        });

        const filteredMaterials = computed(() => {
          let list = [];
          if (materialView.value === 'FG') list = fgBalance.value;
          else if (materialView.value === 'SF') list = sfBalance.value;
          else list = [...fgBalance.value, ...sfBalance.value];

          if (psiProductionFilter.value === 'SCHEDULED') {
            list = list.filter(isMaterialScheduled);
          }

          if (!materialSearch.value.trim()) return list;
          const q = materialSearch.value.trim().toLowerCase();
          return list.filter(m => m.part_no.toLowerCase().includes(q) || (m.description && m.description.toLowerCase().includes(q)));
        });

        const hoveredColKey = ref(null);

        const isAlternateDate = (dateStr) => {
          if (!shiftColumns.value || !shiftColumns.value.length) return false;
          const uniqueDates = [...new Set(shiftColumns.value.map(c => c.date))];
          const idx = uniqueDates.indexOf(dateStr);
          return idx % 2 === 1;
        };

        const displayLineLoads = computed(() => {
          if (!lineLoads.value || lineLoads.value.length === 0) return [];
          if (materialView.value === 'FG') {
            const fgLines = new Set(tasks.value.filter(t => t.stage === 'FG').map(t => t.line));
            const filtered = lineLoads.value.filter(r => fgLines.has(r.line));
            return filtered.length > 0 ? filtered : lineLoads.value;
          }
          if (materialView.value === 'SF') {
            const sfLines = new Set(tasks.value.filter(t => t.stage === 'SF').map(t => t.line));
            const filtered = lineLoads.value.filter(r => sfLines.has(r.line));
            return filtered.length > 0 ? filtered : lineLoads.value;
          }
          return lineLoads.value;
        });

        const fgTasksCount = computed(() => tasks.value.filter(t => t.stage === 'FG').length);
        const sfTasksCount = computed(() => tasks.value.filter(t => t.stage === 'SF').length);

        const filteredGanttTasks = computed(() => {
          if (!tasks.value) return [];
          let list = tasks.value;
          if (ganttLineFilter.value !== 'ALL') {
            list = list.filter(t => t.line === ganttLineFilter.value);
          }
          if (ganttStageFilter.value !== 'ALL') {
            list = list.filter(t => t.stage === ganttStageFilter.value);
          }
          if (ganttStatusFilter.value === 'ON_TIME') {
            list = list.filter(t => !t.is_late);
          } else if (ganttStatusFilter.value === 'LATE') {
            list = list.filter(t => t.is_late);
          }
          if (ganttSearch.value.trim()) {
            const q = ganttSearch.value.trim().toLowerCase();
            list = list.filter(t => 
              t.part_no.toLowerCase().includes(q) || 
              (t.description && t.description.toLowerCase().includes(q)) || 
              t.task_id.toLowerCase().includes(q)
            );
          }
          return list;
        });

        const ganttSwimlanes = computed(() => {
          if (!tasks.value || tasks.value.length === 0) return [];
          const lines = Array.from(new Set(tasks.value.map(t => t.line)));
          lines.sort((a, b) => (a === 'PGLINKAGE' ? -1 : 1));

          return lines.map(line => {
            const lineTasks = filteredGanttTasks.value.filter(t => t.line === line);
            const allLineTasks = tasks.value.filter(t => t.line === line);
            const stage = allLineTasks.length > 0 ? allLineTasks[0].stage : 'FG';
            const trp = allLineTasks.length > 0 ? allLineTasks[0].trp : 0.71;

            // Group lineTasks into parts sub-lanes (Zero Overlap Guaranteed)
            const partMap = new Map();
            lineTasks.forEach(task => {
              if (!partMap.has(task.part_no)) {
                partMap.set(task.part_no, {
                  part_no: task.part_no,
                  description: task.description || '',
                  stage: task.stage,
                  line: task.line,
                  total_qty: 0,
                  total_duration: 0,
                  earliest_start: task.start_dt,
                  tasks: []
                });
              }
              const entry = partMap.get(task.part_no);
              entry.tasks.push(task);
              entry.total_qty += (task.quantity || 0);
              entry.total_duration += (task.duration_hours || 0);
              if (task.start_dt < entry.earliest_start) {
                entry.earliest_start = task.start_dt;
              }
            });

            const parts = Array.from(partMap.values()).sort((a, b) => a.earliest_start.localeCompare(b.earliest_start));

            return {
              line,
              stage,
              trp,
              tasks: lineTasks,
              parts: parts,
            };
          });
        });

        const ganttDateGroups = computed(() => {
          if (!shiftsInfo.value || !shiftsInfo.value.length) return [];
          const groups = [];
          shiftsInfo.value.forEach(s => {
            const existing = groups.find(g => g.date === s.date);
            if (existing) {
              existing.shifts.push(s);
              existing.width_percent = Math.round((existing.width_percent + s.width_percent) * 1000) / 1000;
            } else {
              groups.push({
                date: s.date,
                weekday: s.weekday,
                left_percent: s.left_percent,
                width_percent: s.width_percent,
                shifts: [s],
              });
            }
          });
          return groups;
        });

        const getWeekdayName = (w) => {
          return ['周一', '周二', '周三', '周四', '周五', '周六', '周日'][w] || '';
        };

        const isTaskLinked = (task) => {
          if (!enableBomLinkHighlight.value) return false;
          const active = hoveredTask.value || selectedTask.value;
          if (!active) return false;
          if (active.task_id === task.task_id) return true;
          if (active.stage === 'FG' && task.stage === 'SF') {
            return active.bom_children && active.bom_children.some(c => c.part_no === task.part_no);
          }
          if (active.stage === 'SF' && task.stage === 'FG') {
            return active.bom_parents && active.bom_parents.includes(task.part_no);
          }
          return false;
        };

        const getTaskColorClass = (task) => {
          if (isTaskLinked(task)) {
            return 'bg-gradient-to-r from-cyan-600 to-blue-600 text-white shadow-lg ring-2 ring-cyan-300 ring-offset-1';
          }
          if (task.stage === 'FG') {
            if (task.part_no.includes('76959') || task.part_no.includes('9317')) return 'bg-gradient-to-r from-indigo-600 to-blue-600 text-white shadow-sm';
            if (task.part_no.includes('76960') || task.part_no.includes('8194') || task.part_no.includes('8574')) return 'bg-gradient-to-r from-purple-600 to-violet-600 text-white shadow-sm';
            return 'bg-gradient-to-r from-slate-700 to-indigo-800 text-white shadow-sm';
          } else {
            if (task.part_no.includes('76958') || task.part_no.includes('9318') || task.part_no.includes('9324')) return 'bg-gradient-to-r from-amber-500 to-orange-500 text-white shadow-sm';
            return 'bg-gradient-to-r from-emerald-600 to-teal-600 text-white shadow-sm';
          }
        };

        const openTaskDetail = (task) => {
          selectedTask.value = task;
          showTaskModal.value = true;
        };

        const closeTaskDetail = () => {
          showTaskModal.value = false;
        };

        const onTaskHover = (task) => {
          hoveredTask.value = task;
        };

        const onTaskLeave = () => {
          hoveredTask.value = null;
        };

        const passedCheckCount = computed(() => {
          return checks.value.filter(c => c.passed).length;
        });

        // Input statistics computed
        const totalDemandQty = computed(() => {
          if (!inputData.value.orders) return 0;
          return inputData.value.orders.reduce((sum, o) => sum + (o.demand_quantity || 0), 0);
        });

        const uniqueDemandParts = computed(() => {
          if (!inputData.value.orders) return [];
          return Array.from(new Set(inputData.value.orders.map(o => o.part_no)));
        });

        const filteredOrders = computed(() => {
          if (!inputData.value.orders) return [];
          if (!orderSearch.value.trim()) return inputData.value.orders;
          const q = orderSearch.value.trim().toLowerCase();
          return inputData.value.orders.filter(o => 
            o.part_no.toLowerCase().includes(q) || 
            (o.description && o.description.toLowerCase().includes(q)) || 
            o.order_id.toLowerCase().includes(q)
          );
        });

        const totalStockQty = computed(() => {
          if (!inputData.value.initial_stock) return 0;
          return inputData.value.initial_stock.reduce((sum, s) => sum + (s.quantity || 0), 0);
        });

        const fgStockQty = computed(() => {
          if (!inputData.value.initial_stock || !inputData.value.fg_params) return 0;
          const fgParts = new Set(inputData.value.fg_params.map(p => p.part_no));
          return inputData.value.initial_stock.filter(s => fgParts.has(s.part_no)).reduce((sum, s) => sum + (s.quantity || 0), 0);
        });

        const sfStockQty = computed(() => {
          if (!inputData.value.initial_stock || !inputData.value.sf_params) return 0;
          const sfParts = new Set(inputData.value.sf_params.map(p => p.part_no));
          return inputData.value.initial_stock.filter(s => sfParts.has(s.part_no)).reduce((sum, s) => sum + (s.quantity || 0), 0);
        });

        const zeroStockCount = computed(() => {
          if (!inputData.value.initial_stock) return 0;
          return inputData.value.initial_stock.filter(s => (s.quantity || 0) <= 0).length;
        });

        const filteredStock = computed(() => {
          if (!inputData.value.initial_stock) return [];
          if (!stockSearch.value.trim()) return inputData.value.initial_stock;
          const q = stockSearch.value.trim().toLowerCase();
          return inputData.value.initial_stock.filter(s => s.part_no.toLowerCase().includes(q));
        });

        const isFGPart = (pn) => {
          if (!inputData.value.fg_params) return false;
          return inputData.value.fg_params.some(p => p.part_no === pn);
        };

        const getPartDescription = (pn) => {
          if (inputData.value.fg_params) {
            const fg = inputData.value.fg_params.find(p => p.part_no === pn);
            if (fg) return fg.description;
          }
          if (inputData.value.sf_params) {
            const sf = inputData.value.sf_params.find(p => p.part_no === pn);
            if (sf) return sf.description;
          }
          return "-";
        };

        const filteredToolingMolds = computed(() => {
          if (!inputData.value.tooling_molds) return [];
          if (!toolingSearch.value.trim()) return inputData.value.tooling_molds;
          const q = toolingSearch.value.trim().toLowerCase();
          return inputData.value.tooling_molds.filter(m =>
            m.mold_id.toLowerCase().includes(q) ||
            m.mold_name.toLowerCase().includes(q) ||
            (m.applicable_lines && m.applicable_lines.some(l => l.toLowerCase().includes(q))) ||
            (m.applicable_parts && m.applicable_parts.some(p => p.toLowerCase().includes(q)))
          );
        });

        const filteredPMSchedules = computed(() => {
          if (!inputData.value.pm_schedules) return [];
          if (!pmSearch.value.trim()) return inputData.value.pm_schedules;
          const q = pmSearch.value.trim().toLowerCase();
          return inputData.value.pm_schedules.filter(p =>
            p.pm_plan_no.toLowerCase().includes(q) ||
            p.line.toLowerCase().includes(q) ||
            p.equipment_name.toLowerCase().includes(q) ||
            p.pm_type.toLowerCase().includes(q)
          );
        });

        const filteredMaterialArrivals = computed(() => {
          if (!inputData.value.material_arrivals) return [];
          if (!materialEtaSearch.value.trim()) return inputData.value.material_arrivals;
          const q = materialEtaSearch.value.trim().toLowerCase();
          return inputData.value.material_arrivals.filter(m =>
            m.po_number.toLowerCase().includes(q) ||
            m.supplier.toLowerCase().includes(q) ||
            m.part_no.toLowerCase().includes(q) ||
            m.description.toLowerCase().includes(q) ||
            (m.associated_part && m.associated_part.toLowerCase().includes(q))
          );
        });

        const filteredCustomerTiers = computed(() => {
          if (!inputData.value.customer_tiers) return [];
          if (!customerSearch.value.trim()) return inputData.value.customer_tiers;
          const q = customerSearch.value.trim().toLowerCase();
          return inputData.value.customer_tiers.filter(c =>
            c.customer_code.toLowerCase().includes(q) ||
            c.customer_name.toLowerCase().includes(q) ||
            c.tier.toLowerCase().includes(q)
          );
        });

        // Methods
        const loadInputs = async () => {
          try {
            const res = await fetch('/api/inputs');
            const data = await res.json();
            inputData.value = data;
            if (data.calendar_info) {
              calendarInfo.value = data.calendar_info;
            }
          } catch (e) {
            console.error("Failed to load inputs", e);
          }
        };

        const loadRules = async (site) => {
          try {
            const targetSite = site || selectedSite.value;
            const res = await fetch(`/api/rules?site=${targetSite}`);
            const data = await res.json();
            (data.rules || []).forEach(r => {
              if (!r.load_limit_mode) {
                r.load_limit_mode = '100';
              }
            });
            rules.value = data.rules;
          } catch (e) {
            console.error("Failed to load rules", e);
          }
        };

        const selectAllRules = (val) => {
          rules.value.forEach(r => r.checked = val);
        };

        const resetRulesDefault = () => {
          rules.value.forEach(r => {
            r.checked = true;
            r.load_limit_mode = '100';
          });
