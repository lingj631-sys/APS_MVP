            await loadCalendar();
            await loadRules(selectedSite.value);
            kpi.value = null;
            hasSolved.value = false;
            showToast(`已切换至【${selectedSite.value}】工厂，生产策略配置已同步更新为该工厂专属设置！`);
          } catch (e) {
            console.error("Failed to switch site", e);
          }
        };

        const getLoadCellClass = (metric, val) => {
          if (metric === 'Loading Rate') {
            if (val > 105.0) return 'bg-rose-100 text-rose-800 font-bold ring-1 ring-rose-400';
            // 100% ~ 105% (不含100%): 可以接受但谨慎使用，以黄色背景展示
            if (val > 100.0) return 'bg-yellow-200 text-amber-950 font-bold ring-1 ring-yellow-400 shadow-2xs';
            // 95% ~ 100% (含100%): 正常满载情况
            if (val >= 95.0) return 'bg-emerald-50 text-emerald-800 font-bold';
            // < 95%: 未达开工负荷门槛
            if (val > 0) return 'bg-amber-50 text-amber-800 font-medium';
            return 'bg-white text-slate-300';
          }
          if (metric === 'Loading Hours') {
            if (val > 8.4) return 'bg-rose-100 text-rose-800 font-bold ring-1 ring-rose-400';
            if (val > 8.0) return 'bg-yellow-200 text-amber-950 font-bold ring-1 ring-yellow-400 shadow-2xs';
            if (val >= 7.6) return 'bg-emerald-50 text-emerald-800 font-bold';
            if (val > 0) return 'bg-white text-slate-800 font-semibold';
            return 'bg-white text-slate-300';
          }
          return 'bg-white text-slate-500';
        };

        const formatMetricValue = (metric, val) => {
          if (val === undefined || val === null) return '-';
          if (metric === 'Loading Rate') {
            return val > 0 ? val + '%' : '-';
          }
          if (metric === 'Loading Hours') {
            return val > 0 ? val + 'h' : '-';
          }
          return val;
        };

        const getStatusBadgeClass = (status) => {
          if (status.includes('PASS')) return 'bg-emerald-100 text-emerald-800 border border-emerald-300';
          if (status.includes('FAIL')) return 'bg-rose-100 text-rose-800 border border-rose-300';
          if (status.includes('SKIPPED')) return 'bg-slate-200 text-slate-700';
          if (status.includes('N.A.')) return 'bg-slate-100 text-slate-500';
          return 'bg-amber-100 text-amber-800';
        };

        const getEmptyShiftReason = (line, shiftKey) => {
          if (!emptyShiftReasons.value) return null;
          const key = `${line}|${shiftKey}`;
          return emptyShiftReasons.value[key] || null;
        };

        const getEmptyShiftTooltip = (line, shiftKey) => {
          const info = getEmptyShiftReason(line, shiftKey);
          if (!info) return "班次未排产 (负荷为 0)";
          return `【算法考量 - ${info.reason_tag}】\n${info.reason_title}\n${info.reason_detail}`;
        };

        const toggleAuditRuleExpand = (ruleId) => {
          if (expandedAuditRules.value.has(ruleId)) {
            expandedAuditRules.value.delete(ruleId);
          } else {
            expandedAuditRules.value.add(ruleId);
          }
        };

        const isAuditRuleExpanded = (ruleId) => {
          return expandedAuditRules.value.has(ruleId);
        };

        const expandAllAuditRules = () => {
          complianceMatrix.value.forEach(r => expandedAuditRules.value.add(r.rule_id));
        };

        const collapseAllAuditRules = () => {
          expandedAuditRules.value.clear();
        };

        const getCheckMetric = (ruleId, key) => {
          if (!complianceMatrix.value || !complianceMatrix.value.length) return null;
          const rule = complianceMatrix.value.find(r => r.rule_id === ruleId);
          if (!rule || !rule.metrics) return null;
          return rule.metrics[key] !== undefined ? rule.metrics[key] : null;
        };

        const onManualExcelUpload = async (event) => {
          const file = event.target.files && event.target.files[0];
          if (!file) return;

          uploadingManualExcel.value = true;
          try {
            const formData = new FormData();
            formData.append('file', file);
            formData.append('site', selectedSite.value);

            const res = await fetch('/api/audit_manual_schedule', {
              method: 'POST',
              body: formData,
            });

            if (!res.ok) {
              let errData = null;
              try { errData = await res.json(); } catch (_) {}
              alert('手工排产审计失败: ' + (errData && errData.detail ? errData.detail : res.statusText));
              return;
            }

            const data = await res.json();

            if (!isManualAudited.value) {
              backupAutoScheduleData.value = {
                kpi: kpi.value,
                shiftColumns: shiftColumns.value,
                lineLoads: lineLoads.value,
                fgBalance: fgBalance.value,
                sfBalance: sfBalance.value,
                tasks: tasks.value,
                checks: checks.value,
                complianceMatrix: complianceMatrix.value,
                emptyShiftReasons: emptyShiftReasons.value,
              };
            }

            kpi.value = data.kpi;
            shiftColumns.value = data.shift_columns;
            lineLoads.value = data.line_loads;
            fgBalance.value = data.fg_balance;
            sfBalance.value = data.sf_balance;
            tasks.value = data.tasks;
            checks.value = data.checks;
            complianceMatrix.value = data.compliance_matrix;
            emptyShiftReasons.value = data.empty_shift_reasons || {};

            isManualAudited.value = true;
            manualFilename.value = file.name;
            currentTab.value = 'compliance';

            showToast(`已成功完成手工排产 [${file.name}] 的合规审计！检出 ${data.checks.filter(c => !c.passed).length} 项违规。`);
          } catch (e) {
            alert('上传审计发生异常: ' + e.message);
          } finally {
            uploadingManualExcel.value = false;
            event.target.value = '';
          }
        };

        const restoreAutoSchedule = () => {
          if (!backupAutoScheduleData.value) return;
          kpi.value = backupAutoScheduleData.value.kpi;
          shiftColumns.value = backupAutoScheduleData.value.shiftColumns;
          lineLoads.value = backupAutoScheduleData.value.lineLoads;
          fgBalance.value = backupAutoScheduleData.value.fgBalance;
          sfBalance.value = backupAutoScheduleData.value.sfBalance;
          tasks.value = backupAutoScheduleData.value.tasks;
          checks.value = backupAutoScheduleData.value.checks;
          complianceMatrix.value = backupAutoScheduleData.value.complianceMatrix;
          emptyShiftReasons.value = backupAutoScheduleData.value.emptyShiftReasons;
          isManualAudited.value = false;
          manualFilename.value = '';
          showToast('已恢复为排产算法原始优化计算结果。');
        };

        onMounted(async () => {
          await loadSiteSettings();
          await loadInputs();
          await loadRules(selectedSite.value);
          await loadCalendar();
          // Initial load remains standby; computation triggered by user clicking '执行智能排产'
        });

        return {
          selectedSite,
          calendarMode,
          horizonDays,
          startDate,
          baselineDate,
          onStartDateChange,
          onBaselineDateChange,
          calendarConfig,
          dayShiftOverrides,
          currentTab,
          materialView,
          materialSearch,
          selectedRuleCategory,
          selectedRuleNature,
          ruleSearchQuery,
          expandedRules,
          complianceCategoryFilter,
          complianceStatusFilter,
          toggleRuleExpand,
          expandAllAiLogic,
          getCategoryBadgeClass,
          ruleNatures,
          filteredComplianceMatrix,
          showUpperLoadTable,
          inputMenu,
          orderSearch,
          stockSearch,
          toolingSearch,
          pmSearch,
          materialEtaSearch,
          customerSearch,
          filteredToolingMolds,
          filteredPMSchedules,
          filteredMaterialArrivals,
          filteredCustomerTiers,
          showAddOrderModal,
          newOrder,
          solving,
          hasSolved,
          timerSeconds,
          toastMessage,
          inputData,
          calendarInfo,
          rules,
          kpi,
          shiftColumns,
          lineLoads,
          displayLineLoads,
          hoveredColKey,
          isAlternateDate,
          fgBalance,
          sfBalance,
          tasks,
          checks,
          complianceMatrix,
          ganttViewMode,
          ganttLineFilter,
          ganttStageFilter,
          ganttStatusFilter,
          ganttSearch,
          enableBomLinkHighlight,
          hoveredTask,
          selectedTask,
          showTaskModal,
          ganttHorizon,
          shiftsInfo,
          fgTasksCount,
          sfTasksCount,
          filteredGanttTasks,
          ganttSwimlanes,
          ganttDateGroups,
          getWeekdayName,
          isTaskLinked,
          getTaskColorClass,
          openTaskDetail,
          closeTaskDetail,
          onTaskHover,
          onTaskLeave,
          enabledRulesCount,
          ruleCategories,
          filteredRules,
          filteredMaterials,
          passedCheckCount,
          totalDemandQty,
          uniqueDemandParts,
          filteredOrders,
          totalStockQty,
          fgStockQty,
          sfStockQty,
          zeroStockCount,
          filteredStock,
          isFGPart,
          getPartDescription,
          runSolve,
          saveInputEdits,
          deleteOrder,
          confirmAddOrder,
          resetInputs,
          exportExcel,
          selectAllRules,
          resetRulesDefault,
          onSiteChange,
          getLoadCellClass,
          formatMetricValue,
          getStatusBadgeClass,
          loadCalendar,
          selectHorizon,
          toggleDayWork,
          toggleShiftWork,
          applyCalendarTemplate,
          saveCalendarConfig,
          saveAndSolve,
          showOverloadModal,
          overloadInfo,
          resolveOverloadWith7x3,
          resolveOverloadWith15Days,
          showLineDetailModal,
          showAiRecModal,
          adoptAiRecommendation,
          siteSettings,
          lookaheadSummary,
          calendarModeDisplay,
          loadSiteSettings,
          saveSiteSettings,
          resetSiteSettingsDefault,
          ganttTrackMode,
          psiProductionFilter,
          totalMaterialsInStage,
          scheduledMaterialsCount,
          emptyShiftReasons,
          getEmptyShiftReason,
          getEmptyShiftTooltip,
          expandedAuditRules,
          toggleAuditRuleExpand,
          isAuditRuleExpanded,
          expandAllAuditRules,
          collapseAllAuditRules,
          getCheckMetric,
          uploadingManualExcel,
          isManualAudited,
          manualFilename,
          manualExcelInput,
          onManualExcelUpload,
          restoreAutoSchedule,
        };
      }
    }).mount('#app');
  </script>
</body>
</html>
