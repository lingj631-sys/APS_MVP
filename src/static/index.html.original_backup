              </table>
            </div>
          </div>

          <!-- All Lines Breakdown Table -->
          <div v-if="calendarConfig.ai_recommendation.line_loads && calendarConfig.ai_recommendation.line_loads.length" class="space-y-1.5">
            <h4 class="font-bold text-slate-800 uppercase text-[11px] tracking-wider">全厂产线工时负载透视 (Line Loading Breakdown):</h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
              <div v-for="ll in calendarConfig.ai_recommendation.line_loads" :key="ll.line"
                   class="border border-slate-200 rounded-xl p-3 bg-slate-50/60 flex items-center justify-between">
                <div>
                  <div class="font-bold text-slate-800 flex items-center space-x-1.5">
                    <span>产线: {{ ll.line }}</span>
                    <span class="text-[10px] px-1.5 py-0.2 rounded font-normal" :class="ll.stage === 'FG' ? 'bg-blue-100 text-blue-700' : 'bg-amber-100 text-amber-700'">
                      {{ ll.stage === 'FG' ? '成品装配' : '半成品冲压' }}
                    </span>
                  </div>
                  <div class="text-[11px] text-slate-500 mt-0.5">
                    需求工时: <b class="text-slate-700">{{ ll.req_hours }}h</b> / 极限可用 {{ ll.full_capacity_hours }}h
                  </div>
                </div>
                <div class="text-right">
                  <div class="text-sm font-bold font-mono" :class="ll.ratio > 100 ? 'text-rose-600' : (ll.ratio > 71.4 ? 'text-amber-600' : 'text-emerald-600')">
                    {{ ll.ratio }}%
                  </div>
