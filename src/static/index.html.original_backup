            const res = await fetch('/api/inputs/update', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                orders: inputData.value.orders,
                initial_stock: inputData.value.initial_stock,
                tooling_molds: inputData.value.tooling_molds,
