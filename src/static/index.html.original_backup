        const saveSiteSettings = async () => {
          try {
            siteSettings.value.site = selectedSite.value;
            siteSettings.value.horizon_days = horizonDays.value;
            siteSettings.value.calendar_mode = calendarMode.value;
            siteSettings.value.start_date = startDate.value;
            siteSettings.value.baseline_date = baselineDate.value;
            siteSettings.value.day_shift_overrides = dayShiftOverrides.value;

