                    <td class="py-2.5 px-3 text-center font-mono font-bold"
                        :class="t.load_rate > 100 ? 'text-rose-600' : (t.load_rate >= 95 ? 'text-amber-600' : 'text-emerald-600')">
                      {{ t.load_rate }}%
                    </td>
                    <td class="py-2.5 px-3 text-center">
                      <span class="px-2 py-0.5 rounded text-[10.5px] font-bold"
                            :class="{
                              'bg-rose-100 text-rose-800': t.status === 'OVERLOAD',
                              'bg-amber-100 text-amber-800': t.status === 'CRITICAL',
                              'bg-emerald-100 text-emerald-800': t.status === 'OPTIMAL',
                              'bg-blue-100 text-blue-800': t.status === 'UNDERLOAD'
                            }">
                        {{ t.status_text }}
                      </span>
                    </td>
                    <td class="py-2.5 px-3 text-center">
                      <button v-if="t.mode_code !== calendarMode"
                              @click="applyCalendarTemplate(t.mode_code)"
                              class="px-2 py-1 text-[11px] font-semibold text-indigo-700 hover:text-indigo-900 hover:bg-indigo-50 rounded transition cursor-pointer">
                        切换为此制式
                      </button>
                      <span v-else class="text-[11px] text-slate-400 font-medium">应用中</span>
