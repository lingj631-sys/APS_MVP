<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>APS 智能高级排产系统 MVP</title>
  <script src="/static/tailwind.js"></script>
  <script src="/static/vue.global.prod.js"></script>
  <style>
    [v-cloak] { display: none !important; }

    /* Custom scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    ::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94a3b8;
    }

    /* Single Unified Schedule Table Alignment (Fixed Total Left Width = 540px) */
    .sync-table {
      table-layout: fixed;
      border-collapse: collapse;
      border-spacing: 0;
      min-width: max-content;
    }

    .sync-col-1 {
      position: sticky;
      left: 0;
      width: 110px;
      min-width: 110px;
      max-width: 110px;
    }
    .sync-col-2 {
      position: sticky;
      left: 110px;
      width: 170px;
      min-width: 170px;
      max-width: 170px;
    }
    .sync-col-3 {
      position: sticky;
      left: 280px;
      width: 130px;
      min-width: 130px;
      max-width: 130px;
    }
    .sync-col-4 {
      position: sticky;
      left: 410px;
      width: 130px;
      min-width: 130px;
      max-width: 130px;
      box-shadow: 3px 0 6px -2px rgba(0, 0, 0, 0.12);
    }
    .sync-shift-col {
      width: 78px;
      min-width: 78px;
      max-width: 78px;
    }

    /* Z-Index layering for Table Sticky Headers & Columns (Freeze Panes) */
    thead {
      position: sticky;
      top: 0;
      z-index: 30;
    }
    thead .sync-col-1,
    thead .sync-col-2,
    thead .sync-col-3,
    thead .sync-col-4 {
      z-index: 40 !important;
    }
    tbody .sync-col-1,
    tbody .sync-col-2,
    tbody .sync-col-3,
    tbody .sync-col-4 {
      z-index: 10;
    }

    /* Hover highlight for sticky columns */
    tr:hover > td.sync-col-1,
    tr:hover > td.sync-col-2,
    tr:hover > td.sync-col-3,
    tr:hover > td.sync-col-4 {
      background-color: #f8fafc !important;
    }

    /* Gantt Chart Custom Styles */
    .gantt-canvas {
      min-width: 1800px;
    }
    .gantt-stripes {
      background-image: repeating-linear-gradient(45deg, rgba(241, 245, 249, 0.7), rgba(241, 245, 249, 0.7) 10px, rgba(226, 232, 240, 0.7) 10px, rgba(226, 232, 240, 0.7) 20px);
    }
    @keyframes pulse-ring {
      0%, 100% { box-shadow: 0 0 0 0 rgba(6, 182, 212, 0.8); }
      50% { box-shadow: 0 0 0 6px rgba(6, 182, 212, 0); }
    }
    .bom-pulse {
      animation: pulse-ring 1.8s infinite;
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased font-sans min-h-screen flex flex-col">
  <div id="app" v-cloak class="flex-1 flex flex-col">
    <!-- Header -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-sm">
      <div class="max-w-[98%] mx-auto px-4 py-2.5 flex flex-wrap items-center justify-between gap-4">
        <!-- Logo & Title -->
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-lg bg-indigo-600 flex items-center justify-center text-white shadow-md shadow-indigo-100">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2"></path>
            </svg>
          </div>
          <div>
            <div class="flex items-center space-x-2">
              <h1 class="text-base font-bold text-slate-900 tracking-tight">APS 智能高级排产系统</h1>
              <span class="text-[11px] bg-indigo-50 text-indigo-700 font-semibold px-2 py-0.5 rounded border border-indigo-200">MVP 演示版</span>
            </div>
            <p class="text-[11px] text-indigo-600 font-medium tracking-tight">精益平准 · 智排未来：面向两阶段协同的高级排产与动态平衡决策中枢</p>
          </div>
        </div>

        <!-- Clean Right Controls: Site Selector + Active Strategy Pill + Export + Solve -->
        <div class="flex items-center space-x-3">
          <!-- Factory Site Selector (Scoped Configuration) -->
          <div class="flex items-center bg-slate-100 rounded-lg p-1 border border-slate-200 text-xs">
            <span class="text-slate-500 px-2 font-medium">工厂站点:</span>
            <select v-model="selectedSite" @change="onSiteChange" class="bg-white border-0 text-slate-800 font-semibold rounded py-1 px-2.5 shadow-sm focus:ring-1 focus:ring-indigo-500 text-xs cursor-pointer">
              <option value="WL">WL 工厂 (WE34 车间 - 雨刮/轴套)</option>
              <option value="SY38">SY38 工厂 (沈阳产线)</option>
            </select>
          </div>

          <!-- Quick Strategy Status Badge (Opens System Settings) -->
          <button @click="currentTab = 'settings'" class="inline-flex items-center space-x-1.5 px-3 py-1.5 bg-slate-100 hover:bg-indigo-50 hover:text-indigo-700 text-slate-600 rounded-lg border border-slate-200 text-xs font-medium transition cursor-pointer" title="点击进入当前工厂生产策略与系统设置">
            <span class="w-2 h-2 rounded-full" :class="siteSettings.lookahead_enabled ? 'bg-emerald-500 ring-2 ring-emerald-200' : 'bg-slate-400'"></span>
            <span class="font-bold text-slate-700">{{ horizonDays }}天</span>
            <span class="text-slate-300">|</span>
            <span>{{ calendarModeDisplay }}</span>
            <span class="text-slate-300">|</span>
            <span :class="siteSettings.lookahead_enabled ? 'text-emerald-700 font-bold' : 'text-slate-500'">前瞻: {{ siteSettings.lookahead_enabled ? '开启(30天)' : '关闭' }}</span>
            <svg class="w-3.5 h-3.5 text-slate-400 ml-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          </button>

          <!-- Storyboard Video Link -->
          <a href="/video" target="_blank" class="inline-flex items-center space-x-1.5 px-3 py-1.5 text-xs font-semibold rounded-lg text-amber-900 bg-amber-100 hover:bg-amber-200 border border-amber-300 shadow-sm transition">
            <span class="text-sm">🎬</span>
            <span>成果与展望视频</span>
          </a>

          <!-- Export Excel Button -->
          <button @click="exportExcel" :disabled="!hasSolved" :class="hasSolved ? 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm' : 'bg-slate-100 text-slate-400 cursor-not-allowed'" class="inline-flex items-center space-x-1 px-3 py-1.5 text-xs font-medium rounded-lg transition">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <span>导出结果 Excel</span>
          </button>

          <!-- Run Solve Button (Primary) -->
          <button @click="runSolve" :disabled="solving" class="inline-flex items-center space-x-1.5 px-4 py-1.5 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-md shadow-indigo-200 transition focus:ring-2 focus:ring-indigo-400 cursor-pointer">
            <svg v-if="solving" class="animate-spin -ml-1 mr-1 h-3.5 w-3.5 text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
            </svg>
            <svg v-else class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>{{ solving ? '正在计算生产计划...' : '执行智能排产' }}</span>
          </button>
        </div>
      </div>

      <!-- KPI Summary Cards (When Solved) -->
      <div v-if="kpi" class="bg-slate-900 text-white px-4 py-2 border-t border-slate-800">
        <div class="max-w-[98%] mx-auto grid grid-cols-2 sm:grid-cols-3 md:grid-cols-6 gap-3 text-xs">
          <div class="flex items-center space-x-2">
            <div class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></div>
            <div>
              <div class="text-slate-400 text-[10px]">计划编制状态 / 计算耗时</div>
              <div class="font-bold text-emerald-300">{{ kpi.status_name }} ({{ kpi.wall_time_seconds }}s)</div>
            </div>
          </div>

          <div>
            <div class="text-slate-400 text-[10px]">准时交付率</div>
            <div class="font-bold text-white flex items-center space-x-1">
              <span :class="kpi.on_time_delivery_rate >= 100 ? 'text-emerald-400' : 'text-amber-400'">{{ kpi.on_time_delivery_rate }}%</span>
              <span class="text-[10px] text-slate-400">({{ kpi.total_fg_tasks - kpi.late_task_count }}/{{ kpi.total_fg_tasks }} 准时)</span>
            </div>
          </div>

          <div>
            <div class="text-slate-400 text-[10px]">产线综合平均负荷</div>
            <div class="font-bold text-white flex items-center space-x-1">
              <span :class="(kpi.avg_line_utilization || 0) >= 95 ? 'text-emerald-400' : 'text-amber-400'">
                {{ kpi.avg_line_utilization || '-' }}%
              </span>
              <span class="text-[10px] text-slate-400 ml-1">(门槛≥95%)</span>
            </div>
          </div>

          <div class="relative">
            <div class="text-slate-400 text-[10px] flex items-center justify-between">
              <span>负荷达标分布</span>
              <button @click.stop="showLineDetailModal = !showLineDetailModal" class="text-indigo-300 hover:text-white underline text-[9px] cursor-pointer flex items-center space-x-0.5">
                <span>查明细</span>
                <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
              </button>
            </div>
            <div class="font-bold text-white flex items-center space-x-1 cursor-pointer" @click.stop="showLineDetailModal = !showLineDetailModal">
              <span v-if="(kpi.unqualified_lines_count || 0) === 0" class="text-emerald-400">
                全部达标 ({{ kpi.qualified_lines_count }}/{{ kpi.total_lines_count }}线)
              </span>
              <span v-else class="flex items-center space-x-1">
                <span class="text-amber-400">{{ kpi.qualified_lines_count }}/{{ kpi.total_lines_count }} 达标</span>
                <span class="text-rose-400 text-[10px] ml-1">({{ kpi.unqualified_lines_count }}线预警)</span>
              </span>
            </div>

            <!-- Popover Dropdown for Line Utilization Details -->
            <div v-if="showLineDetailModal" class="absolute left-0 top-full mt-2 w-72 bg-slate-800 text-white rounded-xl shadow-2xl p-3 z-50 border border-slate-700 space-y-2.5 animate-in fade-in zoom-in-95 duration-100">
              <div class="flex items-center justify-between pb-1.5 border-b border-slate-700 text-xs">
                <div class="font-bold text-slate-200 flex items-center space-x-1.5">
                  <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
                  <span>各产线开工负荷明细</span>
                </div>
                <button @click.stop="showLineDetailModal = false" class="text-slate-400 hover:text-white text-sm font-bold leading-none cursor-pointer">&times;</button>
              </div>
              <div class="space-y-1.5 max-h-56 overflow-y-auto pr-1">
                <div v-for="(rate, line) in kpi.line_utilizations" :key="'kpi-line-'+line" class="flex items-center justify-between p-2 rounded-lg bg-slate-900/70 border border-slate-700/60 text-[11px] hover:border-slate-600 transition">
                  <div class="flex items-center space-x-2 truncate">
                    <span class="w-1.5 h-1.5 rounded-full" :class="rate >= 95 ? 'bg-emerald-400' : 'bg-rose-400'"></span>
                    <span class="font-semibold text-slate-200 truncate" :title="line">{{ line }}</span>
                  </div>
                  <div class="flex items-center space-x-2 font-mono">
                    <span :class="rate >= 95 ? 'text-emerald-400 font-bold' : 'text-rose-400 font-bold'">{{ rate }}%</span>
                    <span :class="rate >= 95 ? 'bg-emerald-950/70 text-emerald-300 border-emerald-700/60' : 'bg-rose-950/70 text-rose-300 border-rose-700/60'" class="text-[9px] px-1.5 py-0.5 rounded border font-sans">
                      {{ rate >= 95 ? '达标' : '未达标' }}
                    </span>
                  </div>
                </div>
              </div>
              <div class="text-[10px] text-slate-400 pt-1.5 border-t border-slate-700/60 flex items-center justify-between">
                <span>门槛标准: 单班定额 ≥95%</span>
                <span class="font-mono text-slate-300">共 {{ kpi.total_lines_count }} 条产线</span>
              </div>
            </div>
          </div>

          <div>
            <div class="text-slate-400 text-[10px]">任务规模 (FG + SF)</div>
            <div class="font-bold text-white">{{ kpi.total_fg_tasks }} 成品 + {{ kpi.total_sf_tasks }} 半成品 = {{ kpi.total_tasks }} 任务</div>
          </div>

          <div>
            <div class="text-slate-400 text-[10px]">排程周期跨度</div>
            <div class="font-bold text-white text-[11px]">{{ kpi.schedule_start ? kpi.schedule_start.slice(5) : '-' }} ~ {{ kpi.schedule_end ? kpi.schedule_end.slice(5) : '-' }}</div>
          </div>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <div class="max-w-[98%] mx-auto px-4 flex space-x-6 text-xs font-medium border-t border-slate-100">
        <button @click="currentTab = 'balance'" :class="currentTab === 'balance' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700'" class="py-2.5 border-b-2 font-semibold flex items-center space-x-1.5 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
          <span>① 生产平衡与负荷总览 (Validation)</span>
          <span v-if="hasSolved" class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        </button>

        <button @click="currentTab = 'tasks'" :class="currentTab === 'tasks' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700'" class="py-2.5 border-b-2 font-semibold flex items-center space-x-1.5 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          <span>② 车间协同排产甘特图 (交互透视)</span>
        </button>

        <button @click="currentTab = 'rules'" :class="currentTab === 'rules' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700'" class="py-2.5 border-b-2 font-semibold flex items-center space-x-1.5 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span>③ 规则与约束配置 (Checkboxes)</span>
          <span class="text-[10px] bg-indigo-100 text-indigo-700 px-1.5 py-0.2 rounded-full font-bold">{{ enabledRulesCount }}/{{ rules.length }}</span>
        </button>

        <button @click="currentTab = 'inputs'" :class="currentTab === 'inputs' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700'" class="py-2.5 border-b-2 font-semibold flex items-center space-x-1.5 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
          <span>④ 输入与排产主数据菜单 (浏览·变更·分析)</span>
        </button>

        <button @click="currentTab = 'compliance'" :class="currentTab === 'compliance' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700'" class="py-2.5 border-b-2 font-semibold flex items-center space-x-1.5 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path></svg>
          <span>⑤ 规则合规审计矩阵 ({{ rules.length }}条)</span>
        </button>

        <button @click="currentTab = 'settings'" :class="currentTab === 'settings' ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500 hover:text-slate-700'" class="py-2.5 border-b-2 font-semibold flex items-center space-x-1.5 transition">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          <span>⑥ ⚙️ 生产策略与系统设置</span>
          <span v-if="siteSettings.lookahead_enabled" class="text-[10px] bg-emerald-100 text-emerald-800 px-1.5 py-0.2 rounded-full font-bold">30天前瞻</span>
        </button>
      </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-[98%] w-full mx-auto p-4 flex flex-col space-y-4">

      <!-- ================= TAB 1: PRODUCTION PLAN & VALIDATION MATRIX ================= -->
      <div v-show="currentTab === 'balance'" class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        
        <!-- Lookahead Notification Banner (If active & solved) -->
        <div v-if="lookaheadSummary && lookaheadSummary.is_enabled" class="bg-gradient-to-r from-emerald-500 to-teal-600 text-white px-4 py-2 flex items-center justify-between text-xs font-medium shadow-inner">
          <div class="flex items-center space-x-2">
            <span class="w-2 h-2 rounded-full bg-white animate-ping"></span>
            <span>🎯 <b>30天需求前瞻已激活</b>：已智能前拉合批 <b>{{ lookaheadSummary.pulled_orders_count }}</b> 个远期订单（合并生产 <b>{{ lookaheadSummary.pulled_quantity_total }}</b> 件），预估减少产线换型 <b>{{ lookaheadSummary.changeovers_saved_estimate }}</b> 次，为月末储备平准库存！</span>
          </div>
