        const loadSiteSettings = async (site) => {
          try {
            const targetSite = site || selectedSite.value;
            const res = await fetch(`/api/site-settings?site=${targetSite}`);
            if (res.ok) {
              const data = await res.json();
              siteSettings.value = data;
              horizonDays.value = data.horizon_days || 10;
              calendarMode.value = data.calendar_mode || 'SEVEN_ZERO';
              startDate.value = data.start_date || '2026-10-12';
              baselineDate.value = data.baseline_date || '2026-10-11';
              dayShiftOverrides.value = data.day_shift_overrides || {};
            }
          } catch (e) {
            console.error("Failed to load site settings", e);
          }
